# Model provider API keys, loaded automatically by `flue run` and `vite dev`.
# Any provider Pi supports works: https://pi.dev/docs/latest/providers#api-keys
# At least one of these is required — see src/lib/models.ts for the registry.
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# Optional: enables web_search on the assistant and the satellite agent.
# Satellite only calls it when Cala returned no citations. Without a key the
# question card says "Sources unavailable" (no crash).
TAVILY_API_KEY=""

# Cala — verified entity graph. Loaded only by this Flue process (never send
# the key to the Next.js app or the browser). Get a key at
# https://console.cala.ai/api-keys
CALA_API_KEY=""

# Interactive inspection in Cursor: do NOT put a literal key in the repo.
# Add this to ~/.cursor/mcp.json and export CALA_API_KEY in the environment
# Cursor is launched from:
#
# {
#   "mcpServers": {
#     "Cala": {
#       "url": "https://api.cala.ai/mcp/",
#       "headers": {
#         "X-API-KEY": "${env:CALA_API_KEY}"
#       }
#     }
#   }
# }
