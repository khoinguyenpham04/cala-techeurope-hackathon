# Model provider API keys, loaded automatically by `flue run` and `vite dev`.
# Any provider Pi supports works: https://pi.dev/docs/latest/providers#api-keys
# At least one of these is required — see src/lib/models.ts for the registry.
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# Optional: enables the assistant's web_search tool. Without it the tool is
# not mounted and the assistant answers from its own knowledge.
TAVILY_API_KEY=""
